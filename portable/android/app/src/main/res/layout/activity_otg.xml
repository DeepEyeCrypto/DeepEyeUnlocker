<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E1E22"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEEP"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EYE"
                android:textColor="#00F2FF"
                android:textSize="18sp"
                android:textStyle="bold" />
            
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
            
            <TextView
                android:id="@+id/connectionIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● OFFLINE"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Brand Tabs (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none"
            android:background="#252528">
            <LinearLayout
                android:id="@+id/brandTabs1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical">
                <!-- Populated programmatically or existing IDs -->
                <TextView android:id="@+id/brandXiaomi" style="@style/BrandTab" android:text="Xiaomi" android:background="@drawable/brand_tab_selected"/>
                <TextView android:id="@+id/brandSamsung" style="@style/BrandTab" android:text="Samsung"/>
                <TextView android:id="@+id/brandOppo" style="@style/BrandTab" android:text="OPPO"/>
                <TextView android:id="@+id/brandVivo" style="@style/BrandTab" android:text="Vivo"/>
                <TextView android:id="@+id/brandRealme" style="@style/BrandTab" android:text="Realme"/>
                <TextView android:id="@+id/brandHuawei" style="@style/BrandTab" android:text="Huawei"/>
                <TextView android:id="@+id/brandOnePlus" style="@style/BrandTab" android:text="OnePlus"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Model Select & Mode Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#1A1A1E">

            <!-- Model Selector Button -->
            <Button
                android:id="@+id/btnSelectModel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📱 SELECT MODEL"
                android:textColor="#00F2FF"
                android:backgroundTint="#2C2C30"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawableTint="#00F2FF"
                android:paddingHorizontal="16dp"/>

            <!-- Remote Button -->
            <Button
                android:id="@+id/btnRemoteUnlock"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📡 REMOTE"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EA"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- MTP / Permission Guidance Banner -->
        <LinearLayout
            android:id="@+id/mtpBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#332196F3"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USB mode not ready for DeepEye"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/mtpBannerBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/mtpBannerDismiss"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Operations List (Full Width) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ═══ Category A — Flashing & Firmware ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FLASHING &amp; FIRMWARE"
                    android:textColor="#00F2FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnWriteFirmware" style="@style/OperationButton" android:text="⬆ WRITE FIRMWARE"/>
                <Button android:id="@+id/btnReadFirmware" style="@style/OperationButton" android:text="⬇ READ / BACKUP FIRMWARE"/>
                <Button android:id="@+id/btnBackupEfs" style="@style/OperationButtonOrange" android:text="🔐 BACKUP EFS / NV"/>
                <Button android:id="@+id/btnRestoreEfs" style="@style/OperationButtonOrange" android:text="🔓 RESTORE EFS / NV"/>
                <Button android:id="@+id/btnPartitionMgr" style="@style/OperationButton" android:text="📦 PARTITION MANAGER"/>

                <!-- ═══ Category B — Reset & Cleanup ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESET &amp; CLEANUP"
                    android:textColor="#FF6B35"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnFactoryReset" style="@style/OperationButtonDanger" android:text="🗑 FACTORY RESET"/>
                <Button android:id="@+id/btnDemoUnlock" style="@style/OperationButton" android:text="🏪 DEMO → RETAIL"/>
                <Button android:id="@+id/btnSafeWipe" style="@style/OperationButton" android:text="🧹 SAFE WIPE + BACKUP"/>

                <!-- ═══ Category C — FRP & Account ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FRP &amp; ACCOUNT"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnEraseFrp" style="@style/OperationButtonDanger" android:text="🔥 ERASE FRP LOCK"/>
                <Button android:id="@+id/btnRemoveMiAccount" style="@style/OperationButtonDanger" android:text="☁ REMOVE MI CLOUD"/>
                <Button android:id="@+id/btnEfrpMdm" style="@style/OperationButtonDanger" android:text="🏢 ENTERPRISE EFRP HOOK"/>
                <Button android:id="@+id/btnMtkMetaFrp" style="@style/OperationButtonDanger" android:text="⚡ MTK METAMODE FRP"/>

                <!-- ═══ Category D — Locks & Security ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOCKS &amp; SECURITY"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnRemovePin" style="@style/OperationButtonOrange" android:text="🔑 REMOVE SCREEN LOCK"/>
                <Button android:id="@+id/btnLockState" style="@style/OperationButton" android:text="🔍 LOCK STATE ANALYSIS"/>
                <Button android:id="@+id/btnUnlockBl" style="@style/OperationButton" android:text="🔓 UNLOCK BOOTLOADER"/>
                <Button android:id="@+id/btnMdmRemove" style="@style/OperationButtonDanger" android:text="🏦 MDM / FINANCE UNLOCK"/>

                <!-- ═══ Category E — IMEI & Network ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMEI &amp; NETWORK"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnReadImei" style="@style/OperationButton" android:text="📋 IMEI INTEGRITY CHECK"/>
                <Button android:id="@+id/btnImeiRestore" style="@style/OperationButtonOrange" android:text="🔧 IMEI RESTORE"/>
                <Button android:id="@+id/btnModemRepair" style="@style/OperationButtonOrange" android:text="📡 5G MODEM / CPID REPAIR"/>
                <Button android:id="@+id/btnNetworkUnlock" style="@style/OperationButtonDanger" android:text="🌐 NETWORK / SIM UNLOCK"/>

                <!-- ═══ Category F — Advanced & Diagnostics ═══ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADVANCED &amp; DIAGNOSTICS"
                    android:textColor="#00F2FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnReadInfo" style="@style/OperationButton" android:text="🔍 DEEP DEVICE INFO"/>
                <Button android:id="@+id/btnAdbEnable" style="@style/OperationButton" android:text="⚙ ADB / DIAG ENABLE"/>
                <Button android:id="@+id/btnOneClickRoot" style="@style/OperationButton" android:text="🌱 ONE-CLICK ROOT"/>
                <Button android:id="@+id/btnAppManager" style="@style/OperationButton" android:text="📱 ADB APP MANAGER"/>

                <!-- Bottom spacing -->
                <View android:layout_width="match_parent" android:layout_height="80dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- LOG OVERLAY (Freya Style Popup) -->
    <RelativeLayout
        android:id="@+id/logOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Console Window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/panel_bg"
            android:orientation="vertical">

            <!-- Title Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#222222"
                android:paddingHorizontal="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROCESS LOG"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>

                <ImageView
                    android:id="@+id/btnCloseLog"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FF5252"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Scrollable Terminal -->
            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:padding="12dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/terminalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="> Initializing...\n> Waiting for device..."
                    android:textColor="#00E676"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"/>
            </ScrollView>
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
