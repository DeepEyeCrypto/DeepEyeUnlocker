<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMOTE UNLOCK PROTOCOL"
        android:textColor="#BB86FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="24dp"/>

    <!-- Section 1: SHARE (AnyDesk Style) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR DEVICE (SHARE USB)"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:id="@+id/iconStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_share"
                android:tint="#333333"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                
                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAITING FOR USB..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtSubStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect OTG to generate Session ID"
                    android:textColor="#888888"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Session ID Display -->
        <LinearLayout
            android:id="@+id/sessionBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E22"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtSessionCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--- ---"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"/>
                
            <Button
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="COPY"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnStartShare"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="START SHARING"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="#00E676"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- Section 2: CONNECT (Technician Mode) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMOTE DEVICE (CONNECT)"
        android:textColor="#00F2FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTER SESSION ID"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/inputSessionId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. 192.168.1.5:33000"
            android:textColorHint="#444444"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:background="#1E1E22"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONNECT &amp; UNLOCK"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="12sp"
            android:backgroundTint="#00F2FF"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</LinearLayout>

