<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMOTE UNLOCK PROTOCOL"
        android:textColor="#BB86FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="24dp"/>

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/iconStatus"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#333333"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY TO SHARE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/txtSubStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect USB device via OTG to begin"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Session Code Box -->
    <LinearLayout
        android:id="@+id/sessionBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E22"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SESSION CODE"
            android:textColor="#00F2FF"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtSessionCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- ---"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginTop="8dp"/>
            
        <Button
            android:id="@+id/btnCopy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="COPY"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <!-- Action Button -->
    <Button
        android:id="@+id/btnStartShare"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="START SHARING"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="14sp"
        android:backgroundTint="#00E676"/>

</LinearLayout>
