{
  "productName": "DeepEyeUnlocker",
  "version": "2027.0.12",
  "identifier": "com.deepeye.otg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepEye Unlocker",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/ios_backup/**/*",
      "python/ios_bypass/**/*",
      "python/ios_exploit/**/*",
      "resources/linux/**/*",
      "resources/macos/**/*",
      "resources/windows/**/*"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 400,
          "y": 100
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        },
        {
          "name": "idevice_id",
          "cmd": "idevice_id",
          "args": true
        },
        {
          "name": "ideviceinfo",
          "cmd": "ideviceinfo",
          "args": true
        },
        {
          "name": "idevicepair",
          "cmd": "idevicepair",
          "args": true
        },
        {
          "name": "idevicesyslog",
          "cmd": "idevicesyslog",
          "args": true
        },
        {
          "name": "irecovery",
          "cmd": "irecovery",
          "args": true
        },
        {
          "name": "hashcat",
          "cmd": "hashcat",
          "args": true
        },
        {
          "name": "idevicerestore",
          "cmd": "idevicerestore",
          "args": true
        },
        {
          "name": "ideviceactivation",
          "cmd": "ideviceactivation",
          "args": true
        },
        {
          "name": "ideviceprofile",
          "cmd": "ideviceprofile",
          "args": true
        },
        {
          "name": "checkra1n",
          "cmd": "checkra1n",
          "args": true
        },
        {
          "name": "gaster",
          "cmd": "gaster",
          "args": true
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true
        },
        {
          "name": "ssh",
          "cmd": "ssh",
          "args": true
        },
        {
          "name": "scp",
          "cmd": "scp",
          "args": true
        },
        {
          "name": "edl",
          "cmd": "edl",
          "args": true
        },
        {
          "name": "fastboot",
          "cmd": "fastboot",
          "args": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/DeepEyeCrypto/DeepEyeUnlocker/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
