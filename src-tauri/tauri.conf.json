{
  "productName": "DeepEyeUnlocker",
  "version": "2026.31.0",
  "identifier": "com.deepeye.unlocker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepEye Unlocker",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "python/": "python/"
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "python3",
          "cmd": "python3",
          "args": true
        },
        {
          "name": "idevice_id",
          "cmd": "idevice_id",
          "args": true
        },
        {
          "name": "ideviceinfo",
          "cmd": "ideviceinfo",
          "args": true
        },
        {
          "name": "idevicepair",
          "cmd": "idevicepair",
          "args": true
        },
        {
          "name": "idevicesyslog",
          "cmd": "idevicesyslog",
          "args": true
        },
        {
          "name": "irecovery",
          "cmd": "irecovery",
          "args": true
        },
        {
          "name": "ideviceenterrecovery",
          "cmd": "ideviceenterrecovery",
          "args": true
        },
        {
          "name": "hashcat",
          "cmd": "hashcat",
          "args": true
        },
        {
          "name": "idevicerestore",
          "cmd": "idevicerestore",
          "args": true
        },
        {
          "name": "ideviceactivation",
          "cmd": "ideviceactivation",
          "args": true
        },
        {
          "name": "ideviceprofile",
          "cmd": "ideviceprofile",
          "args": true
        },
        {
          "name": "checkra1n",
          "cmd": "checkra1n",
          "args": true
        },
        {
          "name": "gaster",
          "cmd": "gaster",
          "args": true
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true
        },
        {
          "name": "ssh",
          "cmd": "ssh",
          "args": true
        },
        {
          "name": "scp",
          "cmd": "scp",
          "args": true
        }
      ]
    }
  }
}
