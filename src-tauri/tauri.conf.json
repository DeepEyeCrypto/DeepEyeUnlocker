{
  "productName": "DeepEyeUnlocker",
  "version": "2027.20.0",
  "identifier": "com.deepeye.otg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepEye Unlocker",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/StoreLogo.png",
      "icons/icon.ico"
    ],
    "resources": [
      "python/ios_backup/**/*",
      "python/ios_bypass/**/*",
      "python/ios_exploit/**/*",
      "resources/linux/**/*",
      "resources/macos/**/*",
      "resources/windows/**/*",
      "resources/deepeye-core"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://raw.githubusercontent.com/DeepEyeCrypto/DeepEyeUnlocker/main/releases/latest.json"
      ],
      "pubkey": "YOUR_TAURI_UPDATER_PUBKEY"
    }
  }
}
